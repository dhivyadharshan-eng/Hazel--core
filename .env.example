# Hazel Core — optional API keys.
# Copy this to `.env` and fill in values. NEVER commit the real `.env`.

# OpenAI-compatible key (enables a real LLM for planning + AI voice).
# Leave blank to run on the deterministic orchestrator + free Edge neural TTS.
HAZEL_OPENAI_API_KEY=

# Optional: point at any OpenAI-compatible endpoint (set from data/config.json).
#OPENAI_BASE_URL=https://api.openai.com/v1
